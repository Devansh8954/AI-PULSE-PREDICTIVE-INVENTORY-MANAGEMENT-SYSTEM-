# =============================================================================
# AI-Pulse — Root .gitignore
# =============================================================================
# Protects sensitive files across the entire repository.
# The backend/ folder has its own .gitignore too (belt + suspenders).
# =============================================================================

# ── Root-level npm artefacts (there should be NO package.json at root) ────────
/node_modules/
/package-lock.json


# ── SECRETS — Never commit these ─────────────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
# .env.example is intentionally NOT ignored — it's a safe blank template

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
out/
.angular/
coverage/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12

# ── Docker ────────────────────────────────────────────────────────────────────
# Local override file for docker-compose (put your dev overrides here)
docker-compose.override.yml
# Docker volumes synced locally (if you ever use bind-mounts for db_data)
.docker/

# ── Database dumps / backups (never commit raw SQL exports) ───────────────────
backup.sql
backup*.sql
*.dump
dump.sql


INTERVIEW.md
interview.md
*interview*
*Interview*
*INTERVIEW*

# Private docs — keep out of git (public docs in docs/ ARE committed)
docs/INTERVIEW_QA.md
docs/PRODUCTION.md
docs/aws_management_guide.md.resolved
docs/INTERVIEW.md
docs/EC2_FRESH_DEPLOY.md

materials/
material/
*.private
private/

